# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set this in .env.local for local development.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Set this to the URL where the app is served.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Gmail SMTP Configuration for Automated Community Hub Emails
GMAIL_USER="your-sending-account@gmail.com"
GMAIL_APP_PASSWORD="YOUR_16_CHAR_GMAIL_APP_PASSWORD"

# ADMIN_EMAILS: Comma-separated list of admin accounts allowed to call mail/admin API endpoints.
# The server verifies the caller's sign-in token and checks their email against this list.
ADMIN_EMAILS="admin@example.com"

# FIREBASE_API_KEY: Optional server-side override used to verify sign-in tokens.
# Defaults to the apiKey in firebase-applet-config.json when unset.
FIREBASE_API_KEY="MY_FIREBASE_WEB_API_KEY"

